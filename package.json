{
  "name": "@cmsnt/license-sdk",
  "version": "0.4.2",
  "description": "Reusable Ed25519 license SDK: token core, NestJS enforcement client, edge (Web Crypto) verifier, and a self-served Next.js activation middleware.",
  "license": "UNLICENSED",
  "private": false,
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "default": "./dist/edge/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "nest": [
        "dist/nest/index.d.ts"
      ],
      "edge": [
        "dist/edge/index.d.ts"
      ],
      "next": [
        "dist/next/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "next": ">=13",
    "reflect-metadata": ">=0.1.13"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "next": "^15.0.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  }
}
