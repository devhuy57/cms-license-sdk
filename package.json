{
  "name": "@cmsnt/license-sdk",
  "version": "0.1.0",
  "description": "Reusable Ed25519 license SDK: token core, NestJS enforcement client, and edge (Web Crypto) verifier.",
  "license": "UNLICENSED",
  "private": false,
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "default": "./dist/edge/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "reflect-metadata": ">=0.1.13"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.6.0"
  }
}
